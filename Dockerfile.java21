# Container image for building the project
FROM maven:3.9.5-eclipse-temurin-21 as build
LABEL maintainer="se-fbk"

# Parameter for skipping the tests in the build process
ARG SKIP_TESTS=true

WORKDIR /build

# Copy files and directories needed for building
COPY pom.xml ./
COPY shaded ./shaded/
COPY standalone_runtime ./standalone_runtime/
COPY plugins ./plugins/
COPY runtime ./runtime/
COPY client ./client/
COPY master ./master/

# Build the project
# The -e flag is to show errors and -B to run in non-interactive aka “batch” mode
# Lastly, make build-artifact naming version-independent
RUN mvn -e -B package -DskipTests=${SKIP_TESTS} && \
    mkdir -p /build/bin && \
    mv master/target/evosuite-master-*-tests.jar bin/evosuite-tests.jar && \
    mv master/target/evosuite-master-*.jar bin/evosuite.jar

# Container image for running EvoSuite
FROM eclipse-temurin:21-jdk

WORKDIR /evosuite
VOLUME /evosuite

# Copy the evosuite jar from the builder to this container
COPY --from=build /build/bin /evosuite-bin

# The executable is evosuite
# Note: this list matches the one EvoSuite.java adds for the forked client process
# (see master/src/main/java/org/evosuite/EvoSuite.java) - keep them in sync. With
# -Dclient_on_thread=true, the client runs in this same JVM and only gets what's
# passed here, so it doesn't benefit from EvoSuite.java's own list.
# -Djava.rmi.server.useCodebaseOnly=false lets this JVM (acting as master, or as
# client under -Dclient_on_thread=true) fetch classes referenced in RMI-received
# objects that aren't on its own classpath, from whichever codebase the sender
# advertised - see EvoSuite.java's own codebase-computing fix, which covers the
# forked-client side; a static flag is all that's needed here since the actual
# codebase URL depends on the -projectCP given at runtime, not at image-build time.
ENTRYPOINT ["java", "--add-opens=java.base/java.lang=ALL-UNNAMED", "--add-opens=java.base/java.util=ALL-UNNAMED", "--add-opens=java.base/java.lang.reflect=ALL-UNNAMED", "--add-opens=java.base/java.io=ALL-UNNAMED", "--add-opens=java.base/java.text=ALL-UNNAMED", "--add-opens=java.desktop/java.awt=ALL-UNNAMED", "--add-opens=java.desktop/java.awt.font=ALL-UNNAMED", "--add-opens=java.desktop/javax.swing=ALL-UNNAMED", "--add-opens=java.desktop/sun.awt=ALL-UNNAMED", "--add-opens=java.desktop/sun.font=ALL-UNNAMED", "-Djava.security.manager=allow", "-Djava.rmi.server.useCodebaseOnly=false", "-jar", "/evosuite-bin/evosuite.jar"]

# The default argument is the help menu
# This can be overidden on the command line
CMD ["-help"]

